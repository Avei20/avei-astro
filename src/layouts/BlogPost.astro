---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-us", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<!--
  Layout.astro already exposes <slot name="head" /> inside <head>, so SEO meta
  is injected through that named slot rather than duplicating the full document.
-->
<Layout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
  </Fragment>

  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {
          updatedDate && (
            <span>
              {" "}&middot; updated{" "}
              <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time>
            </span>
          )
        }
        {tags.length > 0 && <span> &middot; {tags.join(", ")}</span>}
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <p class="back"><a href="/blog/">&larr; Back to all posts</a></p>
  </article>
</Layout>

<style>
  article {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }
  header {
    margin-bottom: 2rem;
  }
  .meta {
    opacity: 0.7;
    margin: 0.5rem 0 0;
  }
  .prose :global(p) {
    line-height: 1.7;
  }
  .prose :global(h2) {
    margin-top: 1.5rem;
  }
  .back {
    margin-top: 2.5rem;
  }
</style>
